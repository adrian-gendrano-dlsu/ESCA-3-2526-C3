<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for Firebase and device HTTP requests. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Check whether a network connection is available. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Show alerts and the ongoing monitoring notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibrate the phone for simulated high-risk alerts. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keep the user-started demo session running in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required for the declared special-use foreground service on Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Application-wide configuration. Cleartext HTTP supports prototype devices. -->
    <application
        android:name=".ThesisApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.ESCA_3_2526_C3">

        <!-- Driver launcher entry. The two roles currently have separate app icons. -->
        <activity android:name=".MainActivity" android:exported="true"
            android:label="ESCA-3-2526-C3 Driver"
            android:icon="@android:drawable/ic_menu_directions">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Supervisor launcher entry, separate from the driver interface. -->
        <activity android:name=".SupervisorActivity" android:exported="true"
            android:label="ESCA-3-2526-C3 Supervisor"
            android:icon="@android:drawable/ic_menu_myplaces">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Internal settings screen, opened from within the app. -->
        <activity android:name=".SettingsActivity" android:exported="false"/>

        <!-- User-started foreground demo service for session state and break reminders. -->
        <!-- The subtype describes its purpose; camera detection is not integrated here. -->
        <service android:name=".DriverMonitoringService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started driver safety research demo and two-hour break reminders" />
        </service>

        <!-- Receive Firebase Cloud Messaging alerts -->
        <service android:name=".DemoMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>
</manifest>
